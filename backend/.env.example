DATABASE_URL=postgresql+psycopg2://cytech:cytech@localhost:5432/cytech
JWT_SECRET=change-me-32-chars-minimum
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Google Cloud Console → Credentials → OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# GitHub → Settings → Developer settings → OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
FRONTEND_URL=http://localhost:5173
ADMIN_DOMAIN=cytech.com
CORS_ORIGINS=http://localhost:5173
# OpenRouter (uso futuro: integraciones IA) — valor real solo en .env local
OPENROUTER_API_KEY=
# Demo local sin IdP. ¡En producción: false!
DEMO_LOGIN_ENABLED=true
# PayPal: crea tu app en developer.paypal.com (sandbox) y pega las credenciales
# + habilita Google Pay en Apps & Credentials → Features
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
# Kafka: localhost:9092 con docker compose --profile messaging (vacío = solo log)
KAFKA_BROKERS=
# Agente IA: chat + embeddings por OpenRouter (OPENROUTER_API_KEY ya está en .env)
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
# Email transaccional (Resend). Vacío = solo log en desarrollo
RESEND_API_KEY=
